      <span
        ref={ref}
        className={cn(badgeVariants({ variant, size }), className)}
        {...props}
      >
        {children}
      </span>
    );
  }
);

Badge.displayName = 'Badge';

// Export all
export { cardVariants, cardHeaderVariants, cardFooterVariants, badgeVariants };
