                      />
                  </ProjectCard>
                );
              })}
              
              <div className={`flex ${denseMode ? 'min-h-[4.75rem]' : 'min-h-[5rem] sm:min-h-[5.5rem]'}`}>
                <CreateProjectCard onClick={createProject} className="flex-1" />
